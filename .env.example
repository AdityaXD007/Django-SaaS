DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-real-envs
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Host port for PostgreSQL container (override if you have a local PostgreSQL service on 5432).
# NOTE: POSTGRES_PORT and the port inside DATABASE_URL are SEPARATE values and must be changed TOGETHER.
# If you change POSTGRES_PORT (the Docker host binding), you MUST also update the port in DATABASE_URL.
# Example: POSTGRES_PORT=5433  =>  DATABASE_URL=postgres://launchkit:launchkit@localhost:5433/launchkit
POSTGRES_PORT=5432
DATABASE_URL=postgres://launchkit:launchkit@localhost:5432/launchkit
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email settings (Phase 4 - invitations)
# In development, emails are printed to the console. Set to smtp.EmailBackend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Invitation settings
INVITATION_EXPIRY_DAYS=7
# Base URL of your frontend (used to build the accept-invite link in emails)
FRONTEND_URL=http://localhost:3000
# Return raw invitation token in POST response (safe for local development only, default False)
INVITATION_RETURN_TOKEN=False
