DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-real-envs
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Host port for PostgreSQL container (override if you have a local PostgreSQL service on 5432)
POSTGRES_PORT=5432
DATABASE_URL=postgres://launchkit:launchkit@localhost:5432/launchkit
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
